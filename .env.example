# Required for AI-assisted payment verification and chat
GEMINI_API_KEY=

# Public URL of this panel
APP_URL=http://localhost:3000

# Required in production; use unique values stored only in the server environment
JTS_SUPERADMIN_EMAIL=
JTS_SUPERADMIN_PASSWORD=
JTS_MOBILE_CONTRACT_SECRET=

# Optional payment channels (leave blank until you configure your verified recipients)
MTN_MOMO_BENEFICIARY=
MTN_MOMO_NUMBER=
ORANGE_MONEY_BENEFICIARY=
ORANGE_MONEY_NUMBER=
ORANGE_MERCHANT_OM_ASSO=
ORANGE_MONTHLY_CEILING_FCFA=1500000

# Hosts used in tunnel profiles
JTS_DEFAULT_SERVER_HOST=
JTS_VPS_FR_HOST=
JTS_VPS_DE_HOST=

# Optional SlowDNS server configuration
JTS_SLOWDNS_NS_DOMAIN=
JTS_SLOWDNS_PUBKEY=
